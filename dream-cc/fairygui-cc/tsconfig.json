{
  "compilerOptions": {
    "declaration": true,
    "target": "es6",
    "module": "es6",
    "strict": true,
    "strictNullChecks": false,
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "dream-cc-core": [
        "./dist/dream-cc-core.d.ts"
      ]
    },
  },
  "include": [
    "./src/**/*",
    "../libs"
  ],
  "exclude": [
    "node_modules"
  ]
}
