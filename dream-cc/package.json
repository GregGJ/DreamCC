{
  "name": "dream-cc",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "description": "dream-cc monorepo (npm workspaces)",
  "workspaces": [
    "dream-cc-core",
    "dream-cc-ecs",
    "dream-cc-ai",
    "dream-cc-gui",
    "dream-cc-pathfinding",
    "fairygui-cc"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:local": "node ./scripts/build.mjs",
    "dev": "node ./scripts/dev.mjs",
    "copy": "node ./scripts/copy-libs.mjs",
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "turbo run typecheck",
    "typecheck:local": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.2",
    "rollup": "^3.29.5",
    "rollup-plugin-dts": "^6.5.1",
    "turbo": "^2.10.9",
    "typescript": "7.0.2"
  }
}
