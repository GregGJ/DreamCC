{
  "compilerOptions": {
    "declaration": false,
    "target": "ES6",
    "module": "ES6",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "dream-cc-core": [
        "./dist/dream-cc-core.d.ts"
      ],
      "fairygui-cc": [
        "./dist/fairygui-cc.d.ts"
      ]
    },
    "strict": false, // 开启所有严格类型检查选项
  },
  "include": [
    "./src/**/*",
    "../libs"
  ],
  "exclude": [
    "node_modules"
  ]
}
